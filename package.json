{
  "name": "spacesaver",
  "version": "1.0.0",
  "description": "Smart disk space cleanup and file organizer for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "dist": "electron-builder --win --publish never"
  },
  "author": "SpaceSaver",
  "license": "MIT",
  "build": {
    "appId": "com.spacesaver.app",
    "productName": "SpaceSaver",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.0"
  }
}
